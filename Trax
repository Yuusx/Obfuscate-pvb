local function autoPickup()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Tool") and obj.Parent ~= player.Backpack and obj.Parent ~= player.Character then
            pcall(function() obj.Parent = player.Backpack end)
        end
    end
end

local function categorizeItems()
    autoPickup()
    unequipAll()
    local plants, brainrots, tools = {}, {}, {}
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                local nameLower = item.Name:lower()
                local isTool = false
                for _, tname in ipairs(TOOL_NAMES) do
                    if string.find(nameLower,tname) then
                        table.insert(tools,"馃洜 "..item.Name)
                        isTool = true
                        break
                    end
                end
                if isTool then continue end
                if string.find(nameLower,"brain") or string.find(nameLower,"brainrot") or string.find(nameLower,"kg") then
                    table.insert(brainrots,"馃 "..item.Name)
                else
                    table.insert(plants,"馃尶 "..item.Name)
                end
            end
        end
    end
    return plants, brainrots, tools
end

local function sendItemToRecipient(itemInstance, recipientName)
    local remote = getGiftRemote()
    if not remote then return false end
    unequipAll()
    local success = false
    pcall(function()
        itemInstance.Parent = player.Character
        remote:FireServer({[1]={["Item"]=itemInstance, ["ToGift"]=recipientName}, [2]=string.char(21)})
        success = true
    end)
    return success
end

